# Copy this file to .env and fill in real values yourself. Never paste a
# private key or seed phrase into a chat with an AI assistant; type it in here.

# RPC endpoint for Robinhood Chain (chain id 4663). Leave unset to use the
# public fallback baked into the scripts (https://rpc.mainnet.chain.robinhood.com).
RPC_URL=

# Comma-separated 0x-prefixed private keys, e.g. 0xabc...,0xdef...
# Use fresh wallets funded only with what you intend to spend on gas + mint price.
PRIVATE_KEYS=

# Optional: fixed shared secret for the coordinator <-> worker HTTP link.
# If you leave this unset, mine-hashcats.mjs / hashcats-dash.mjs print or
# accept a random one each run instead.
HASHCATS_TOKEN=
